# Managed bindings are supplied by Lovable Cloud. Do not commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only (managed); never prefix private credentials with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY= (server-only; required for signed-out audit + upload bridge on self-hosted
#   deployments; never VITE_-prefixed, never committed). Not exportable from the managed project.
# Missing VITE_/SUPABASE_ URL or publishable key => the app shows a "Configuration needed" page and
#   /api/public/metadata returns 503; it does not crash.
# Render build: NITRO_PRESET=node-server (see render.yaml). Render provides PORT.
# Local integration suite only; no production defaults are used.
TV_TEST_DATABASE_URL=postgres://nobody@127.0.0.1:55432/tv_test
# Optional provisioned HTTP suite; fixture is a secret JSON value, not committed.
TV_TEST_HTTP_URL=http://localhost:8080
TV_TEST_HTTP_FIXTURES=
# Optional approved, operator-owned malware scanner. Never point at an arbitrary service.
TV_SCANNER_URL=
TV_SCANNER_SECRET=
TV_SCANNER_APPROVED=
# Checkpoints: no production exporter/key/sink configured. Operator-local test tooling only.
# Never store signing private keys here, in DB, browser variables or public artifacts.
# Pins/retained trusted checkpoints and immutable retention require independent operator policy.
